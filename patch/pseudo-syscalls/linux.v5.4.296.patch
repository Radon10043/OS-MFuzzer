+// - Follow-up input: The same KVM virtual machine with vCPUs `vcpu_A` and `vcpu_B`. The follow-up operation is to enable the `KVM_CAP_S390_CSS_SUPPORT` capability on `vcpu_B`.
+// - Input relation: The follow-up input is generated by changing the target of the capability-enabling operation from one vCPU (`vcpu_A`) to another (`vcpu_B`) within the same virtual machine.
+// - Output relation: Since the capability affects the entire virtual machine, the overall state of the VM should be identical in both cases. For instance, executing an I/O instruction that triggers a `KVM_EXIT_S390_TSCH` on any vCPU should produce the same exit reason and data for both the source and follow-up executions. The return value of enabling the capability itself should also be success in both cases.
+
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/kvm.h>
+#include <stdint.h> // For uintN_t types
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+// The syzkaller environment provides the standard UAPI types like __u64.
+// We only need to manually define the s390-specific struct.
+struct kvm_s390_tsch_ff8de7ac {
+	__u16 subchannel_id;
+	__u16 subchannel_nr;
+	__u32 io_int_parm;
+	__u32 io_int_word;
+	__u32 ipb;
+	__u8 schib[52];
+};
+
+// Manually define KVM constants for setting s390 PSW register.
+// These are needed for cross-architecture compilation.
+#ifndef KVM_REG_S390
+#define KVM_REG_S390 0x0000000000070000ULL
+#endif
+#ifndef KVM_REG_SIZE_U64
+#define KVM_REG_SIZE_U64 0x0000000000000100ULL
+#endif
+#ifndef KVM_REG_S390_PSW_MASK_ff8de7ac
+#define KVM_REG_S390_PSW_MASK_ff8de7ac (KVM_REG_S390 | KVM_REG_SIZE_U64 | 0)
+#endif
+#ifndef KVM_REG_S390_PSW_ADDR_ff8de7ac
+#define KVM_REG_S390_PSW_ADDR_ff8de7ac (KVM_REG_S390 | KVM_REG_SIZE_U64 | 1)
+#endif
+
+#define KVM_DEVICE_ff8de7ac "/dev/kvm"
+#define GUEST_MEM_SIZE_ff8de7ac 0x1000
+#define GUEST_CODE_ADDR_ff8de7ac 0
+
+// Structure to hold the results of a single run
+struct run_output_ff8de7ac {
+	long enable_cap_ret;
+	long kvm_run_ret;
+	int exit_reason;
+	struct kvm_s390_tsch_ff8de7ac tsch_data;
+};
+
+// Helper function to perform one execution (source or follow-up)
+static int do_one_run_ff8de7ac(int vcpu_to_run_idx, struct run_output_ff8de7ac* output)
+{
+	// Move ALL variable declarations to the top to avoid "crosses initialization" errors with goto.
+	int ret = -1;
+	int kvm_fd = -1, vm_fd = -1;
+	int vcpu_fds[2] = {-1, -1};
+	void* guest_mem = NULL;
+	struct kvm_run* kvm_runs[2] = {NULL, NULL};
+	size_t vcpu_mmap_size = 0;
+	struct kvm_userspace_memory_region region;
+	struct kvm_enable_cap cap;
+	// TSCH 0(0) instruction (opcode B237 0000)
+	uint32_t guest_code[] = {0xb2370000};
+
+	kvm_fd = open(KVM_DEVICE_ff8de7ac, O_RDWR | O_CLOEXEC);
+	if (kvm_fd < 0) {
+		return -1;
+	}
+
+	vm_fd = ioctl(kvm_fd, KVM_CREATE_VM, 0);
+	if (vm_fd < 0) {
+		goto cleanup;
+	}
+
+	vcpu_fds[0] = ioctl(vm_fd, KVM_CREATE_VCPU, 0);
+	if (vcpu_fds[0] < 0) {
+		goto cleanup;
+	}
+	vcpu_fds[1] = ioctl(vm_fd, KVM_CREATE_VCPU, 1);
+	if (vcpu_fds[1] < 0) {
+		goto cleanup;
+	}
+
+	guest_mem = mmap(NULL, GUEST_MEM_SIZE_ff8de7ac, PROT_READ | PROT_WRITE,
+			 MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+	if (guest_mem == MAP_FAILED) {
+		guest_mem = NULL;
+		goto cleanup;
+	}
+
+	memset(&region, 0, sizeof(region));
+	region.slot = 0;
+	region.guest_phys_addr = GUEST_CODE_ADDR_ff8de7ac;
+	region.memory_size = GUEST_MEM_SIZE_ff8de7ac;
+	region.userspace_addr = (uintptr_t)guest_mem;
+	if (ioctl(vm_fd, KVM_SET_USER_MEMORY_REGION, &region) < 0) {
+		goto cleanup;
+	}
+
+	memcpy(guest_mem, guest_code, sizeof(guest_code));
+
+	vcpu_mmap_size = ioctl(kvm_fd, KVM_GET_VCPU_MMAP_SIZE, NULL);
+	if (vcpu_mmap_size < sizeof(struct kvm_run)) {
+		goto cleanup;
+	}
+
+	for (int i = 0; i < 2; i++) {
+		// Explicitly cast mmap's return value for C++ compatibility.
+		kvm_runs[i] = (struct kvm_run*)mmap(NULL, vcpu_mmap_size, PROT_READ | PROT_WRITE,
+						    MAP_SHARED, vcpu_fds[i], 0);
+		if (kvm_runs[i] == MAP_FAILED) {
+			kvm_runs[i] = NULL;
+			goto cleanup;
+		}
+
+		// Set initial PSW using KVM_SET_ONE_REG to be arch-agnostic at compile time.
+		__u64 psw_mask_val = 0x0000000180000000ULL; // problem state, DAT on
+		__u64 psw_addr_val = GUEST_CODE_ADDR_ff8de7ac;
+
+		struct kvm_one_reg psw_mask_reg = {
+		    .id = KVM_REG_S390_PSW_MASK_ff8de7ac,
+		    .addr = (uintptr_t)&psw_mask_val,
+		};
+		if (ioctl(vcpu_fds[i], KVM_SET_ONE_REG, &psw_mask_reg) < 0) {
+			goto cleanup;
+		}
+
+		struct kvm_one_reg psw_addr_reg = {
+		    .id = KVM_REG_S390_PSW_ADDR_ff8de7ac,
+		    .addr = (uintptr_t)&psw_addr_val,
+		};
+		if (ioctl(vcpu_fds[i], KVM_SET_ONE_REG, &psw_addr_reg) < 0) {
+			goto cleanup;
+		}
+	}
+
+	memset(&cap, 0, sizeof(cap));
+	cap.cap = KVM_CAP_S390_CSS_SUPPORT;
+	output->enable_cap_ret = ioctl(vm_fd, KVM_ENABLE_CAP, &cap);
+
+	output->kvm_run_ret = ioctl(vcpu_fds[vcpu_to_run_idx], KVM_RUN, 0);
+	if (output->kvm_run_ret >= 0) {
+		output->exit_reason = kvm_runs[vcpu_to_run_idx]->exit_reason;
+		if (output->exit_reason == KVM_EXIT_S390_TSCH) {
+			memcpy(&output->tsch_data, &kvm_runs[vcpu_to_run_idx]->s390_tsch, sizeof(struct kvm_s390_tsch_ff8de7ac));
+		}
+	}
+
+	ret = 0; // Indicate that the setup and run attempt completed.
+
+cleanup:
+	if (kvm_runs[0])
+		munmap(kvm_runs[0], vcpu_mmap_size);
+	if (kvm_runs[1])
+		munmap(kvm_runs[1], vcpu_mmap_size);
+	if (guest_mem)
+		munmap(guest_mem, GUEST_MEM_SIZE_ff8de7ac);
+	if (vcpu_fds[0] >= 0)
+		close(vcpu_fds[0]);
+	if (vcpu_fds[1] >= 0)
+		close(vcpu_fds[1]);
+	if (vm_fd >= 0)
+		close(vm_fd);
+	if (kvm_fd >= 0)
+		close(kvm_fd);
+
+	return ret;
+}
+
+static long syz_mr_ff8de7ac(volatile long dummy)
+{
+	(void)dummy;
+
+	// Check if the required capability is supported by the host KVM
+	int kvm_fd = open(KVM_DEVICE_ff8de7ac, O_RDWR | O_CLOEXEC);
+	if (kvm_fd < 0) {
+		// Cannot open KVM, cannot run the test.
+		return -1;
+	}
+	int cap_supported = ioctl(kvm_fd, KVM_CHECK_EXTENSION, KVM_CAP_S390_CSS_SUPPORT);
+	close(kvm_fd);
+	if (!cap_supported) {
+		// Capability not supported, MR is not applicable.
+		return 0;
+	}
+
+	// Source execution: enable cap, run on vCPU 0
+	struct run_output_ff8de7ac source_output = {.kvm_run_ret = -1};
+	if (do_one_run_ff8de7ac(0, &source_output) != 0) {
+		// A failure in do_one_run indicates a setup problem before the ioctls under test.
+		return -1;
+	}
+
+	// Follow-up execution: enable cap, run on vCPU 1
+	struct run_output_ff8de7ac followup_output = {.kvm_run_ret = -1};
+	if (do_one_run_ff8de7ac(1, &followup_output) != 0) {
+		return -1;
+	}
+
+	int violation = 0;
+
+	// R1: Return value of enabling the capability should be success in both cases.
+	if (source_output.enable_cap_ret < 0 || followup_output.enable_cap_ret < 0) {
+		violation = 1;
+	}
+
+	// R2: The KVM_RUN should succeed in both cases.
+	if (source_output.kvm_run_ret < 0 || followup_output.kvm_run_ret < 0) {
+		violation = 1;
+	} else {
+		// R3: Exit reason should be KVM_EXIT_S390_TSCH for both.
+		if (source_output.exit_reason != KVM_EXIT_S390_TSCH ||
+		    followup_output.exit_reason != KVM_EXIT_S390_TSCH) {
+			violation = 1;
+		}
+
+		// R4: The tsch data should be identical.
+		if (memcmp(&source_output.tsch_data, &followup_output.tsch_data,
+			   sizeof(struct kvm_s390_tsch_ff8de7ac)) != 0) {
+			violation = 1;
+		}
+	}
+
+	if (violation) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!\n");
+	}
+
+	return 0;
+}
