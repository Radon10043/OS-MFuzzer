+static long syz_mr_18cdab70(volatile long a0)
+{
+	if (init_verbs_api_18cdab70() != 0) {
+		// Can't run the test if the library is not available.
+		// This is not an MR violation, but a test setup failure.
+		return -1;
+	}
+
+	struct rdma_resources_18cdab70 sender_res, receiver_res;
+	char source_output_buf[BUFFER_SIZE_18cdab70];
+	char followup_output_buf[BUFFER_SIZE_18cdab70];
+	struct ibv_wc_18cdab70 source_send_wc, source_recv_wc, followup_send_wc, followup_recv_wc;
+	int source_ok = 0, followup_ok = 0;
+
+	// Initialize wc statuses to a non-success value to detect failures properly
+	source_send_wc.status = followup_send_wc.status = IBV_WC_FATAL_ERR;
+	source_recv_wc.status = followup_recv_wc.status = IBV_WC_FATAL_ERR;
+
+	struct ibv_device_18cdab70** dev_list = verbs_api_18cdab70.ibv_get_device_list(NULL);
+	if (!dev_list || !dev_list[0]) {
+		perror("No RDMA devices found");
+		cleanup_verbs_api_18cdab70();
+		return -1;
+	}
+	struct ibv_device_18cdab70* ib_dev = dev_list[0];
+
+	// --- SOURCE EXECUTION: recv then send ---
+	if (setup_rdma_resources_18cdab70(&sender_res, ib_dev) == 0 && setup_rdma_resources_18cdab70(&receiver_res, ib_dev) == 0) {
+		srand(a0);
+		for (int i = 0; i < BUFFER_SIZE_18cdab70; ++i)
+			sender_res.buf[i] = rand();
+		memset(receiver_res.buf, 0, BUFFER_SIZE_18cdab70);
+
+		if (connect_qps_18cdab70(&sender_res, &receiver_res) == 0) {
+			if (post_receive_18cdab70(&receiver_res) == 0 && post_send_18cdab70(&sender_res) == 0) {
+				if (poll_completion_18cdab70(sender_res.cq, &source_send_wc) == 0 &&
+				    poll_completion_18cdab70(receiver_res.cq, &source_recv_wc) == 0) {
+					memcpy(source_output_buf, receiver_res.buf, BUFFER_SIZE_18cdab70);
+					source_ok = 1;
+				}
+			}
+		}
+	}
+	cleanup_rdma_resources_18cdab70(&sender_res);
+	cleanup_rdma_resources_18cdab70(&receiver_res);
+
+	// --- FOLLOW-UP EXECUTION: send then recv ---
+	if (setup_rdma_resources_18cdab70(&sender_res, ib_dev) == 0 && setup_rdma_resources_18cdab70(&receiver_res, ib_dev) == 0) {
+		srand(a0);
+		for (int i = 0; i < BUFFER_SIZE_18cdab70; ++i)
+			sender_res.buf[i] = rand();
+		memset(receiver_res.buf, 0, BUFFER_SIZE_18cdab70);
+
+		if (connect_qps_18cdab70(&sender_res, &receiver_res) == 0) {
+			if (post_send_18cdab70(&sender_res) == 0) {
+				usleep(1000); // Small delay to encourage unexpected message path
+				if (post_receive_18cdab70(&receiver_res) == 0) {
+					if (poll_completion_18cdab70(sender_res.cq, &followup_send_wc) == 0 &&
+					    poll_completion_18cdab70(receiver_res.cq, &followup_recv_wc) == 0) {
+						memcpy(followup_output_buf, receiver_res.buf, BUFFER_SIZE_18cdab70);
+						followup_ok = 1;
+					}
+				}
+			}
+		}
+	}
+	cleanup_rdma_resources_18cdab70(&sender_res);
+	cleanup_rdma_resources_18cdab70(&receiver_res);
+
+	verbs_api_18cdab70.ibv_free_device_list(dev_list);
+
+	// --- VERIFICATION ---
+	if (!source_ok || !followup_ok) {
+		fprintf(stderr, "MR test could not be completed due to setup or operational error.\n");
+		cleanup_verbs_api_18cdab70();
+		return -1; // Indicate test was inconclusive
