+	char* result_buf = malloc(DMA_SIZE);
+	if (result_buf) {
+		memcpy(result_buf, guest_mem + DMA_DST_ADDR, DMA_SIZE);
+	}
+
+	munmap(run, mmap_size);
+	close(vcpu_fd);
+	munmap(guest_mem, GUEST_MEM_SIZE);
+	close(vm_fd);
+
+	return result_buf;
