+static int modify_qp_to_init_18cdab70(struct internal_ibv_qp_18cdab70* qp)
+{
+	struct ibv_qp_attr_18cdab70 attr;
+	memset(&attr, 0, sizeof(attr));
+	attr.qp_state = IBV_QPS_INIT;
+	attr.port_num = IB_PORT_18cdab70;
+	attr.pkey_index = 0;
+	attr.qp_access_flags = IBV_ACCESS_REMOTE_WRITE | IBV_ACCESS_REMOTE_READ;
+
+	if (verbs_api_18cdab70.ibv_modify_qp(qp, &attr,
+					     IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS)) {
+		fprintf(stderr, "Failed to modify QP to INIT state\n");
+		return -1;
+	}
+	return 0;
+}
+
+static int modify_qp_to_rtr_18cdab70(struct internal_ibv_qp_18cdab70* qp, uint32_t remote_qpn, uint16_t remote_lid)
+{
+	struct ibv_qp_attr_18cdab70 attr;
+	memset(&attr, 0, sizeof(attr));
+	attr.qp_state = IBV_QPS_RTR;
+	attr.path_mtu = IBV_MTU_1024;
+	attr.dest_qp_num = remote_qpn;
+	attr.rq_psn = 0;
+	attr.max_dest_rd_atomic = 1;
+	attr.min_rnr_timer = 12;
+	attr.ah_attr.is_global = 0;
+	attr.ah_attr.dlid = remote_lid;
+	attr.ah_attr.sl = 0;
+	attr.ah_attr.src_path_bits = 0;
+	attr.ah_attr.port_num = IB_PORT_18cdab70;
+
+	if (verbs_api_18cdab70.ibv_modify_qp(qp, &attr,
+					     IBV_QP_STATE | IBV_QP_AV | IBV_QP_PATH_MTU | IBV_QP_DEST_QPN | IBV_QP_RQ_PSN |
+						 IBV_QP_MAX_DEST_RD_ATOMIC | IBV_QP_MIN_RNR_TIMER)) {
+		fprintf(stderr, "Failed to modify QP to RTR state\n");
+		return -1;
+	}
+	return 0;
+}
+
+static int modify_qp_to_rts_18cdab70(struct internal_ibv_qp_18cdab70* qp)
+{
+	struct ibv_qp_attr_18cdab70 attr;
+	memset(&attr, 0, sizeof(attr));
+	attr.qp_state = IBV_QPS_RTS;
+	attr.timeout = 14;
+	attr.retry_cnt = 7;
+	attr.rnr_retry = 7;
+	attr.sq_psn = 0;
+	attr.max_rd_atomic = 1;
+
+	if (verbs_api_18cdab70.ibv_modify_qp(qp, &attr,
+					     IBV_QP_STATE | IBV_QP_TIMEOUT | IBV_QP_RETRY_CNT | IBV_QP_RNR_RETRY |
+						 IBV_QP_SQ_PSN | IBV_QP_MAX_QP_RD_ATOMIC)) {
+		fprintf(stderr, "Failed to modify QP to RTS state\n");
+		return -1;
+	}
+	return 0;
+}
