+		return -1;
+	}
+	long bytes_read = read(fd, buffer, max_size);
+	if (bytes_read <= 0) {
+		perror("Failed to read file");
+		close(fd);
+		return -1;
+	}
+	close(fd);
+	return bytes_read;
