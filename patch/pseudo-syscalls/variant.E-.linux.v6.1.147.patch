+// Helper function to run a KVM guest with a given FDT and return the DMA destination buffer
+static char* run_guest(int kvm_fd, unsigned char* fdt, size_t fdt_size, volatile long seed)
+{
+	int vm_fd, vcpu_fd;
+	struct kvm_userspace_memory_region region;
