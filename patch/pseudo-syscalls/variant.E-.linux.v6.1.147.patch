+			} else if (run->hvc.gprs[3] == HVC_FINISH) {
+				done = 1;
+			}
+			break;
+		case KVM_EXIT_FAIL_ENTRY:
+		case KVM_EXIT_INTERNAL_ERROR:
+		default:
+			done = 1; // Abort on error
+			break;
+		}
+	}
