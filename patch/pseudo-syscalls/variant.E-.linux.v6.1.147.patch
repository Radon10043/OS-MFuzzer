+// Modified macro to use decltype (C++11 standard) instead of typeof (GNU extension)
+#define LOAD_VERBS_FUNC_18cdab70(name)                                                                                \
+	do {                                                                                                          \
+		verbs_api_18cdab70.name = (decltype(verbs_api_18cdab70.name))dlsym(verbs_api_18cdab70.handle, #name); \
+		if (!verbs_api_18cdab70.name) {                                                                       \
+			fprintf(stderr, "Failed to find symbol " #name " in libibverbs.so.1\n");                      \
+			dlclose(verbs_api_18cdab70.handle);                                                           \
+			verbs_api_18cdab70.handle = NULL;                                                             \
+			return -1;                                                                                    \
+		}                                                                                                     \
+	} while (0)
+
+static int init_verbs_api_18cdab70(void)
+{
+	if (verbs_api_18cdab70.handle)
+		return 0; // Already initialized
+	verbs_api_18cdab70.handle = dlopen("libibverbs.so.1", RTLD_NOW);
+	if (!verbs_api_18cdab70.handle) {
+		// Try without .1 as a fallback
+		verbs_api_18cdab70.handle = dlopen("libibverbs.so", RTLD_NOW);
+	}
+	if (!verbs_api_18cdab70.handle) {
+		fprintf(stderr, "Failed to open libibverbs.so.1 or libibverbs.so\n");
+		return -1;
+	}
+
+	LOAD_VERBS_FUNC_18cdab70(ibv_get_device_list);
+	LOAD_VERBS_FUNC_18cdab70(ibv_free_device_list);
+	LOAD_VERBS_FUNC_18cdab70(ibv_open_device);
+	LOAD_VERBS_FUNC_18cdab70(ibv_close_device);
+	LOAD_VERBS_FUNC_18cdab70(ibv_query_port);
+	LOAD_VERBS_FUNC_18cdab70(ibv_alloc_pd);
+	LOAD_VERBS_FUNC_18cdab70(ibv_dealloc_pd);
+	LOAD_VERBS_FUNC_18cdab70(ibv_reg_mr);
+	LOAD_VERBS_FUNC_18cdab70(ibv_dereg_mr);
+	LOAD_VERBS_FUNC_18cdab70(ibv_create_cq);
+	LOAD_VERBS_FUNC_18cdab70(ibv_destroy_cq);
+	LOAD_VERBS_FUNC_18cdab70(ibv_create_qp);
+	LOAD_VERBS_FUNC_18cdab70(ibv_destroy_qp);
+	LOAD_VERBS_FUNC_18cdab70(ibv_modify_qp);
+	LOAD_VERBS_FUNC_18cdab70(ibv_post_send);
+	LOAD_VERBS_FUNC_18cdab70(ibv_post_recv);
+	LOAD_VERBS_FUNC_18cdab70(ibv_poll_cq);
+
+	return 0;
+}
