+					goto cleanup;
+				}
+			}
+			break;
+		case KVM_EXIT_FAIL_ENTRY:
+			fprintf(stderr, "KVM_EXIT_FAIL_ENTRY: reason %llu\n", kvm_run_map->fail_entry.hardware_entry_reason);
+			goto cleanup;
+		case KVM_EXIT_INTERNAL_ERROR:
+			fprintf(stderr, "KVM_EXIT_INTERNAL_ERROR: suberror %u\n", kvm_run_map->internal.suberror);
+			goto cleanup;
+		case KVM_EXIT_SHUTDOWN:
+			fprintf(stderr, "Guest shut down.\n");
+			goto cleanup;
+		default:
