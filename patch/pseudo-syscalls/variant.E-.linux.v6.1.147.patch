+static int connect_qps_18cdab70(struct rdma_resources_18cdab70* sender, struct rdma_resources_18cdab70* receiver)
+{
+	if (modify_qp_to_init_18cdab70(sender->qp) || modify_qp_to_init_18cdab70(receiver->qp))
+		return -1;
+	if (modify_qp_to_rtr_18cdab70(receiver->qp, sender->qpn, sender->lid) ||
+	    modify_qp_to_rtr_18cdab70(sender->qp, receiver->qpn, receiver->lid))
+		return -1;
+	if (modify_qp_to_rts_18cdab70(receiver->qp) || modify_qp_to_rts_18cdab70(sender->qp))
+		return -1;
+	return 0;
+}
