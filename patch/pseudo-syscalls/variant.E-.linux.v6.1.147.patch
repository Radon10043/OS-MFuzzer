+static int poll_completion_18cdab70(struct ibv_cq_18cdab70* cq, struct ibv_wc_18cdab70* wc)
+{
+	int num_comp;
+	unsigned long start_time_msec, cur_time_msec;
+	struct timespec cur_time;
+
+	clock_gettime(CLOCK_MONOTONIC, &cur_time);
+	start_time_msec = (cur_time.tv_sec * 1000) + (cur_time.tv_nsec / 1000000);
+
+	do {
+		num_comp = verbs_api_18cdab70.ibv_poll_cq(cq, 1, wc);
+		if (num_comp != 0)
+			break;
+
+		clock_gettime(CLOCK_MONOTONIC, &cur_time);
+		cur_time_msec = (cur_time.tv_sec * 1000) + (cur_time.tv_nsec / 1000000);
+	} while ((cur_time_msec - start_time_msec) < POLL_TIMEOUT_MS_18cdab70);
+
+	if (num_comp < 0) {
+		fprintf(stderr, "ibv_poll_cq failed\n");
+		return -1;
+	}
+	if (num_comp == 0) {
+		fprintf(stderr, "Timeout polling for completion\n");
+		return -1;
+	}
+	return 0;
+}
