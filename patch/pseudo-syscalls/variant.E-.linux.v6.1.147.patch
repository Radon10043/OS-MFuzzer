+static int setup_rdma_resources_18cdab70(struct rdma_resources_18cdab70* res, struct ibv_device_18cdab70* ib_dev)
+{
+	// Moved mr_flags declaration to top of function to avoid "crosses initialization" error with goto
+	int mr_flags = IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE | IBV_ACCESS_REMOTE_READ;
+
+	memset(res, 0, sizeof(*res));
+	if (posix_memalign((void**)&res->buf, sysconf(_SC_PAGESIZE), BUFFER_SIZE_18cdab70)) {
+		fprintf(stderr, "Failed to allocate buffer with posix_memalign\n");
+		return -1;
+	}
+
+	res->context = verbs_api_18cdab70.ibv_open_device(ib_dev);
+	if (!res->context) {
+		fprintf(stderr, "Failed to open device\n");
+		goto err_free_buf;
+	}
+
+	if (verbs_api_18cdab70.ibv_query_port(res->context, IB_PORT_18cdab70, &res->port_attr)) {
+		fprintf(stderr, "Failed to query port attributes\n");
+		goto err_close_device;
+	}
+	res->lid = res->port_attr.lid;
+
+	res->pd = verbs_api_18cdab70.ibv_alloc_pd(res->context);
+	if (!res->pd) {
+		fprintf(stderr, "Failed to allocate PD\n");
+		goto err_close_device;
+	}
+
+	res->cq = verbs_api_18cdab70.ibv_create_cq(res->context, CQ_SIZE_18cdab70, NULL, NULL, 0);
+	if (!res->cq) {
+		fprintf(stderr, "Failed to create CQ\n");
+		goto err_dealloc_pd;
+	}
+
+	res->mr = verbs_api_18cdab70.ibv_reg_mr(res->pd, res->buf, BUFFER_SIZE_18cdab70, mr_flags);
+	if (!res->mr) {
+		fprintf(stderr, "Failed to register MR\n");
+		goto err_destroy_cq;
+	}
+
+	struct ibv_qp_init_attr_18cdab70 qp_init_attr;
+	memset(&qp_init_attr, 0, sizeof(qp_init_attr));
+	qp_init_attr.send_cq = res->cq;
+	qp_init_attr.recv_cq = res->cq;
+	qp_init_attr.qp_type = IBV_QPT_RC;
+	qp_init_attr.cap.max_send_wr = MAX_SEND_WR_18cdab70;
+	qp_init_attr.cap.max_recv_wr = MAX_RECV_WR_18cdab70;
+	qp_init_attr.cap.max_send_sge = 1;
+	qp_init_attr.cap.max_recv_sge = 1;
+
+	res->qp = verbs_api_18cdab70.ibv_create_qp(res->pd, &qp_init_attr);
+	if (!res->qp) {
+		fprintf(stderr, "Failed to create QP\n");
+		goto err_dereg_mr;
+	}
+	res->qpn = res->qp->qp_num;
+	return 0;
+
+err_dereg_mr:
+	verbs_api_18cdab70.ibv_dereg_mr(res->mr);
+err_destroy_cq:
+	verbs_api_18cdab70.ibv_destroy_cq(res->cq);
+err_dealloc_pd:
+	verbs_api_18cdab70.ibv_dealloc_pd(res->pd);
+err_close_device:
+	verbs_api_18cdab70.ibv_close_device(res->context);
+err_free_buf:
+	free(res->buf);
+	memset(res, 0, sizeof(*res));
+	return -1;
+}
+
+static void cleanup_rdma_resources_18cdab70(struct rdma_resources_18cdab70* res)
+{
+	if (!res->context)
+		return;
+	if (res->qp)
+		verbs_api_18cdab70.ibv_destroy_qp(res->qp);
+	if (res->mr)
+		verbs_api_18cdab70.ibv_dereg_mr(res->mr);
+	if (res->cq)
+		verbs_api_18cdab70.ibv_destroy_cq(res->cq);
+	if (res->pd)
+		verbs_api_18cdab70.ibv_dealloc_pd(res->pd);
+	if (res->context)
+		verbs_api_18cdab70.ibv_close_device(res->context);
+	if (res->buf)
+		free(res->buf);
+	memset(res, 0, sizeof(*res));
+}
