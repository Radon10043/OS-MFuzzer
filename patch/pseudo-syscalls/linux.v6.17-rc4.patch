+	if (ret == -1) {
+		close(vcpu_fd_foll);
+		close(vm_fd_foll);
+		close(kvm_fd);
+		return -1;
+	}
+	followup_output = lapic_foll.regs[LAPIC_LVT_LINT0_OFFSET_ffde35c4 / sizeof(__u32)];
+
+	close(vcpu_fd_foll);
+	close(vm_fd_foll);
+	close(kvm_fd);
+
+	// 4. Check the output relation.
+	if (source_output != EXPECTED_SOURCE_LINT0_ffde35c4 || followup_output != EXPECTED_FOLLOWUP_LINT0_ffde35c4) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!\n");
+	}
+
+	return 0;
+}
