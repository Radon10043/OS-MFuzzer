+	regs.gpr[1] = mem_size - 0x100; // A basic stack pointer.
+	if (ioctl(vcpu_fd, KVM_SET_REGS, &regs) < 0) {
+		// perror("KVM_SET_REGS");
+		goto cleanup;
+	}
