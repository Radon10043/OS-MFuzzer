+	struct kvm_sregs sregs;
+	if (ioctl(vcpu_fd, KVM_GET_SREGS, &sregs) < 0) {
+		// perror("KVM_GET_SREGS");
+		goto cleanup;
+	}
+	sregs.u.ppc.msr |= 0x8000000000000000ULL; // MSR_SF for 64-bit mode.
+	if (ioctl(vcpu_fd, KVM_SET_SREGS, &sregs) < 0) {
+		// perror("KVM_SET_SREGS");
+		goto cleanup;
+	}
+
