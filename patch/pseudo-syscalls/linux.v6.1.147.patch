+ */
+static long syz_mr_fe055772(volatile long a0, volatile long a1)
+{
+	/* 1. Pre-condition: Check kernel ABI version. */
+	int abi_fd = open("/sys/class/infiniband_mad/abi_version", O_RDONLY);
+	if (abi_fd == -1) {
+		// Cannot check ABI version, likely because the driver is not loaded.
+		// We cannot proceed with the test.
+		return 0;
+	}
+
+	char abi_buf[16];
+	ssize_t n = read(abi_fd, abi_buf, sizeof(abi_buf) - 1);
+	close(abi_fd);
+
+	if (n <= 0) {
+		// Failed to read ABI version.
+		return 0;
+	}
+	abi_buf[n] = '\0';
+	long kernel_abi_version = strtol(abi_buf, NULL, 10);
+
+	if (kernel_abi_version > 5) {
+		// This MR is only applicable for ABI versions <= 5.
+		return 0;
+	}
+
+	/* Find an available umad device to use. */
+	char dev_path[256] = {0};
+	int found_dev = 0;
+	for (int i = 0; i < 8; ++i) { // Try umad0 through umad7
+		snprintf(dev_path, sizeof(dev_path), "/dev/infiniband/umad%d", i);
+		int test_fd = open(dev_path, O_RDWR);
+		if (test_fd != -1) {
+			close(test_fd);
+			found_dev = 1;
+			break;
+		}
+	}
+
+	if (!found_dev) {
+		// No umad device found, cannot perform the test.
+		return 0;
+	}
+
+	/* 2. Prepare the MAD buffer with the *new* header format. */
+	// We include a minimal valid MAD payload to make the follow-up write more likely to be accepted.
+	const int data_len = sizeof(struct ib_mad_hdr_fe055772);
+	const int buf_size = sizeof(struct ib_user_mad_hdr_fe055772) + data_len;
+	char* mad_buffer = (char*)malloc(buf_size);
+	if (!mad_buffer) {
+		return 0; // Allocation failed.
+	}
+	memset(mad_buffer, 0, buf_size);
+
+	// Fill the user MAD header (new format).
+	struct ib_user_mad_hdr_fe055772* hdr = (struct ib_user_mad_hdr_fe055772*)mad_buffer;
+	hdr->id = 0xdeadbeef;
+	hdr->length = buf_size; // Total length including header and data.
+	hdr->qpn = 1; // General Services QP.
+	hdr->qkey = 0; // Default QKey.
+	hdr->lid = 1; // A plausible destination LID.
+	hdr->pkey_index = 0; // The new field that differentiates the ABIs.
+
+	// Fill the actual MAD payload (a simple node info query).
+	struct ib_mad_hdr_fe055772* mad_payload = (struct ib_mad_hdr_fe055772*)(mad_buffer + sizeof(struct ib_user_mad_hdr_fe055772));
+	mad_payload->base_version = 1;
+	mad_payload->mgmt_class = IB_MGMT_CLASS_SUBN_LID_ROUTED_fe055772;
+	mad_payload->method = IB_MGMT_METHOD_GET_fe055772;
+	mad_payload->attr_id = htobe16(IB_MGMT_ATTR_NODE_DESC_fe055772);
+
+	/* 3. Source input execution */
+	long res1;
+	int errno1;
+
+	int fd1 = open(dev_path, O_RDWR);
+	if (fd1 == -1) {
+		free(mad_buffer);
+		return 0;
+	}
+
+	res1 = write(fd1, mad_buffer, buf_size);
+	errno1 = errno;
+	close(fd1);
+
+	/* 4. Follow-up input execution */
+	long res2;
+	int errno2;
+
+	int fd2 = open(dev_path, O_RDWR);
+	if (fd2 == -1) {
+		free(mad_buffer);
+		return 0;
+	}
+
+	// Enable the new PKEY-aware ABI for this file descriptor.
+	if (ioctl(fd2, IB_USER_MAD_ENABLE_PKEY_fe055772, 0) == -1) {
+		// If ioctl fails, we cannot test the relation.
+		close(fd2);
+		free(mad_buffer);
+		return 0;
+	}
+
+	res2 = write(fd2, mad_buffer, buf_size);
+	errno2 = errno; // Store errno for debugging, though not strictly required by MR.
+	close(fd2);
+
+	/* 5. Output relation check */
+	// Expected outcome:
+	// - Source write fails with EINVAL because the kernel expects the old, shorter header.
+	// - Follow-up write succeeds because the ioctl switched the kernel to the new header format.
+	int source_failed_as_expected = (res1 == -1 && errno1 == EINVAL);
+	int followup_succeeded_as_expected = (res2 == buf_size);
+
+	if (!(source_failed_as_expected && followup_succeeded_as_expected)) {
+		fprintf(stderr, "[SyzMeta]: MR is violated! res1=%ld (errno=%d), res2=%ld (errno=%d), expected res1=-1/EINVAL and res2=%d\n",
+			res1, errno1, res2, errno2, buf_size);
+	}
+
+	/* 6. Cleanup */
+	free(mad_buffer);
+
+	return 0;
+}
