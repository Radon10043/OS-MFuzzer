+	guest_mem = mmap(NULL, 0x1000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if (guest_mem == MAP_FAILED) {
+		goto cleanup;
+	}
+	((unsigned char*)guest_mem)[0] = 0xf4; // HLT instruction
+
+	// Initialize and set memory region. The field order must match the struct definition.
+	region = (struct kvm_userspace_memory_region){
+	    .slot = 0,
+	    .flags = 0,
+	    .guest_phys_addr = 0,
+	    .memory_size = 0x1000,
+	    .userspace_addr = (unsigned long)guest_mem,
+	};
+	if (ioctl(vm_fd, KVM_SET_USER_MEMORY_REGION, &region) == -1) {
+		goto cleanup;
+	}
+
+	if (ioctl(vm_fd, KVM_CREATE_IRQCHIP, 0) == -1) {
+		goto cleanup;
+	}
+
+	vcpu_fd = ioctl(vm_fd, KVM_CREATE_VCPU, (unsigned long)0);
+	if (vcpu_fd == -1) {
+		goto cleanup;
+	}
+
+	run_state_size = ioctl(kvm_fd, KVM_GET_VCPU_MMAP_SIZE, NULL);
+	if (run_state_size <= 0) {
+		goto cleanup;
+	}
+	// Explicit cast from void* to struct kvm_run* for C++ compatibility.
+	run_state = (struct kvm_run*)mmap(NULL, run_state_size, PROT_READ | PROT_WRITE, MAP_SHARED, vcpu_fd, 0);
+	if (run_state == (struct kvm_run*)MAP_FAILED) {
+		goto cleanup;
+	}
+
+	if (ioctl(vcpu_fd, KVM_GET_SREGS, &sregs) == -1) {
+		goto cleanup;
+	}
+	sregs.cs.base = 0;
+	sregs.cs.selector = 0;
+	if (ioctl(vcpu_fd, KVM_SET_SREGS, &sregs) == -1) {
+		goto cleanup;
+	}
+
+	regs = (struct kvm_regs){
+	    .rip = 0,
+	    .rflags = 0x2, // Set the mandatory bit 1.
+	};
+	if (ioctl(vcpu_fd, KVM_SET_REGS, &regs) == -1) {
+		goto cleanup;
+	}
+
+	if (ioctl(vcpu_fd, KVM_RUN, 0) == -1 || run_state->exit_reason != KVM_EXIT_HLT) {
+		goto cleanup;
+	}
+
+	// 2. Get the corresponding source output and follow-up output.
+	irq_level_assert = (struct kvm_irq_level){.irq = gsi, .level = 1};
+	r0 = ioctl(vm_fd, KVM_IRQ_LINE, &irq_level_assert);
+
+	if (ioctl(vcpu_fd, KVM_RUN, 0) != -1 && run_state->exit_reason == KVM_EXIT_INTR) {
+		interrupt_count++;
+	}
+
+	irq_level_deassert = (struct kvm_irq_level){.irq = gsi, .level = 0};
+	r1 = ioctl(vm_fd, KVM_IRQ_LINE, &irq_level_deassert);
+
+	if (ioctl(vcpu_fd, KVM_RUN, 0) != -1 && run_state->exit_reason == KVM_EXIT_INTR) {
+		interrupt_count++;
+	}
+
+	// 3. Check if the output relation is violated.
+	if (r0 != 0 || r1 != 0 || interrupt_count != 1) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!\n");
+	}
+
+cleanup:
+	// 4. Perform cleanup.
+	if (run_state != (struct kvm_run*)MAP_FAILED)
+		munmap(run_state, run_state_size);
+	if (vcpu_fd != -1)
+		close(vcpu_fd);
+	if (guest_mem != MAP_FAILED)
+		munmap(guest_mem, 0x1000);
+	if (vm_fd != -1)
+		close(vm_fd);
+	if (kvm_fd != -1)
+		close(kvm_fd);
+
+	return 0;
+}
