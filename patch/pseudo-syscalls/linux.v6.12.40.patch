+// Helper to run a command, returning 0 on success.
+// Renamed to avoid potential collisions.
+static int mr_run_command_ffe9fbe3(const char* cmd)
+{
+	int ret = system(cmd);
+	if (ret != 0) {
+		fprintf(stderr, "Command failed with exit code %d: %s\n", ret, cmd);
+	}
+	return ret;
+}
