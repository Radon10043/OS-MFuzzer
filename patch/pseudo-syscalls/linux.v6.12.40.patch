+// Helper to kill a process using its PID file.
+// Renamed to avoid potential collisions.
+static void mr_kill_process_by_pidfile_ffe9fbe3(const char* pid_file)
+{
+	FILE* f = fopen(pid_file, "r");
+	if (f) {
+		pid_t pid = 0;
+		if (fscanf(f, "%d", &pid) == 1 && pid > 0) {
+			kill(pid, SIGTERM);
+			sleep(1); // Give it a moment to terminate gracefully.
+			kill(pid, SIGKILL); // Force kill if it's still running.
+		}
+		fclose(f);
+	}
+}
