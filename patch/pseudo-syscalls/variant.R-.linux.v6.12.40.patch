+	guest_mem = mmap(NULL, guest_mem_size, PROT_READ | PROT_WRITE,
+			 MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	fail_if_ff9737e0(guest_mem == MAP_FAILED, "mmap guest_mem");
+
+	memset(&region, 0, sizeof(region));
+	region.slot = 0;
+	region.guest_phys_addr = 0;
+	region.memory_size = guest_mem_size;
+	region.userspace_addr = (uint64_t)guest_mem;
+	ret = ioctl(vm_fd, KVM_SET_USER_MEMORY_REGION, &region);
+	fail_if_ff9737e0(ret < 0, "KVM_SET_USER_MEMORY_REGION");
+
+	code_ptr = (uint32_t*)guest_mem;
+	code_ptr[0] = __builtin_bswap32(0x38600000 | liobn);
+	code_ptr[1] = __builtin_bswap32(0x38800000 | io_start);
+	code_ptr[2] = __builtin_bswap32(0x38a00000 | tce_table_addr);
+	code_ptr[3] = __builtin_bswap32(0x38c00000 | num_tces);
+	code_ptr[4] = __builtin_bswap32(0x44000000 | H_STUFF_TCE_ff9737e0);
+	code_ptr[5] = __builtin_bswap32(PPC_TRAP_INSTRUCTION_ff9737e0);
+
+	// 5. vCPU Setup
+	vcpu_fd = ioctl(vm_fd, KVM_CREATE_VCPU, 0);
+	fail_if_ff9737e0(vcpu_fd < 0, "KVM_CREATE_VCPU");
+
+	vcpu_mmap_size = ioctl(kvm_fd, KVM_GET_VCPU_MMAP_SIZE, NULL);
+	fail_if_ff9737e0(vcpu_mmap_size == 0, "KVM_GET_VCPU_MMAP_SIZE");
+	// Add explicit cast for C++ compatibility
+	run_struct = (struct kvm_run*)mmap(NULL, vcpu_mmap_size,
+					   PROT_READ | PROT_WRITE, MAP_SHARED,
+					   vcpu_fd, 0);
+	fail_if_ff9737e0(run_struct == MAP_FAILED, "mmap vcpu_fd");
+
+	// Use KVM_SET_ONE_REG to set PVR and NIP for better portability
+	pvr_val = 0x004e1201; // A generic POWER9 PVR
+	pvr_reg.id = KVM_REG_PPC | KVM_REG_SIZE_U32 | KVM_REG_PPC_PVR_ff9737e0;
+	pvr_reg.addr = (uint64_t)&pvr_val;
+	ret = ioctl(vcpu_fd, KVM_SET_ONE_REG, &pvr_reg);
+	fail_if_ff9737e0(ret < 0, "KVM_SET_ONE_REG PVR");
+
+	nip_val = 0; // Start execution at address 0
+	nip_reg.id = KVM_REG_PPC | KVM_REG_SIZE_U64 | KVM_REG_PPC_NIP_ff9737e0;
+	nip_reg.addr = (uint64_t)&nip_val;
+	ret = ioctl(vcpu_fd, KVM_SET_ONE_REG, &nip_reg);
+	fail_if_ff9737e0(ret < 0, "KVM_SET_ONE_REG NIP for source");
+
+	// 6. Get Source Output
+	ret = ioctl(vcpu_fd, KVM_RUN, NULL);
+	fail_if_ff9737e0(ret < 0, "KVM_RUN source");
+
+	source_exit_reason = run_struct->exit_reason;
+	source_hcall_nr = (source_exit_reason == KVM_EXIT_PAPR_HCALL) ? run_struct->papr_hcall.nr : -1;
+
+	// 7. Get Follow-up Output (after applying input relation)
+	memset(&tce_table, 0, sizeof(tce_table));
+	tce_table.liobn = liobn;
+	tce_table.window_size = 0x10000000;
+	tce_table.levels = 1;
+	ret = ioctl(vm_fd, KVM_CREATE_SPAPR_TCE_64, &tce_table);
+	fail_if_ff9737e0(ret < 0, "KVM_CREATE_SPAPR_TCE_64");
+
+	// Reset vCPU state (only NIP needs resetting)
+	ret = ioctl(vcpu_fd, KVM_SET_ONE_REG, &nip_reg);
+	fail_if_ff9737e0(ret < 0, "KVM_SET_ONE_REG NIP for follow-up");
+
+	ret = ioctl(vcpu_fd, KVM_RUN, NULL);
+	fail_if_ff9737e0(ret < 0, "KVM_RUN follow-up");
+
+	followup_exit_reason = run_struct->exit_reason;
+
+	// 8. Check Output Relation
+	source_ok = (source_exit_reason == KVM_EXIT_PAPR_HCALL &&
+		     source_hcall_nr == H_STUFF_TCE_ff9737e0);
+	followup_ok = (followup_exit_reason == KVM_EXIT_DEBUG);
+
+	if (!source_ok || !followup_ok) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!\n");
+	}
+
+	ret = 0;
+
+cleanup:
+	if (run_struct != MAP_FAILED && run_struct != NULL)
+		munmap(run_struct, vcpu_mmap_size);
+	if (guest_mem != MAP_FAILED)
+		munmap(guest_mem, guest_mem_size);
+	if (tce_dev_fd >= 0)
+		close(tce_dev_fd);
+	if (vcpu_fd >= 0)
+		close(vcpu_fd);
+	if (vm_fd >= 0)
+		close(vm_fd);
+	if (kvm_fd >= 0)
+		close(kvm_fd);
+	return ret;
+}
