+	// The number of FDs must not change if the test call created no device.
+	if (fds_after == -1 || fds_before != fds_after) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!\n");
+		close(dev.fd);
+		return -1;
+	}
+
+	// Follow-up call 2: Re-issuing the same request to check for side effects.
+	long res3 = ioctl((int)vm_fd, KVM_CREATE_DEVICE, &dev_test);
+
+	// This second test call must also succeed.
+	if (res3 != 0) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!\n");
+		close(dev.fd);
+		return -1;
+	}
+
+	// --- 4. Cleanup ---
+	close(dev.fd);
+
+	// If all checks passed, the metamorphic relation holds.
+	return 0;
+}
