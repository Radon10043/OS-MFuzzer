+// Helper function to find and open a uverbs device
+static int open_uverbs_device_fe907391()
+{
+	for (int i = 0; i < 8; ++i) {
+		char path[256];
+		snprintf(path, sizeof(path), "/dev/infiniband/uverbs%d", i);
+		int fd = open(path, O_RDWR);
