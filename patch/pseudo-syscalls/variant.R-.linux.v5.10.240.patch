+	kvm_fd = open("/dev/kvm", O_RDWR | O_CLOEXEC);
+	if (kvm_fd == -1) {
+		// KVM is not available, cannot run the test.
+		return 0;
+	}
+
+	// Check if the host supports the HPT resize capability.
+	if (ioctl(kvm_fd, KVM_CHECK_EXTENSION, KVM_CAP_PPC_RESIZE_HPT_f7655e00) <= 0) {
+		// Capability not supported, cannot run the test.
+		goto cleanup;
+	}
+
+	// 2. Get the source output
+	vm_fd_src = ioctl(kvm_fd, KVM_CREATE_VM, 0);
+	if (vm_fd_src == -1) {
+		goto cleanup;
+	}
+
+	if (ioctl(vm_fd_src, KVM_PPC_RESIZE_HPT_PREPARE, &p1) == -1) {
+		// Precondition for the MR is not met. The PREPARE call must succeed.
+		goto cleanup;
+	}
+	source_output = ioctl(vm_fd_src, KVM_PPC_RESIZE_HPT_COMMIT, &p1);
+	close(vm_fd_src);
+	vm_fd_src = -1;
+
+	// 3. Get the follow-up output
+	vm_fd_fup = ioctl(kvm_fd, KVM_CREATE_VM, 0);
+	if (vm_fd_fup == -1) {
+		goto cleanup;
+	}
+
+	if (ioctl(vm_fd_fup, KVM_PPC_RESIZE_HPT_PREPARE, &p1) == -1) {
+		// Precondition for the MR is not met. The PREPARE call must succeed.
+		goto cleanup;
+	}
+	if (ioctl(vm_fd_fup, KVM_PPC_RESIZE_HPT_COMMIT, &p2) == -1) {
+		followup_output = -errno;
+	} else {
+		// The ioctl succeeded, which is unexpected.
+		followup_output = 0;
+	}
+	close(vm_fd_fup);
+	vm_fd_fup = -1;
+
+	// 4. Check the output relation
+	// Source call should succeed (0), follow-up should fail with ENXIO.
+	if (!(source_output == 0 && followup_output == -ENXIO)) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!");
+	}
+
+cleanup:
+	if (vm_fd_src != -1)
+		close(vm_fd_src);
+	if (vm_fd_fup != -1)
+		close(vm_fd_fup);
+	if (kvm_fd != -1)
+		close(kvm_fd);
+
+	return 0;
+}
