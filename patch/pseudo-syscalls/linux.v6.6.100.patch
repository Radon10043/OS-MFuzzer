+// Helper function to get mount options for a given mount point from /proc/mounts.
+// Returns a dynamically allocated string with the options, or NULL if not found/error.
+// The caller is responsible for freeing the returned string.
+static char* get_mount_options_00a81376(const char* mount_point)
+{
+	FILE* mounts_file = fopen("/proc/mounts", "r");
+	if (!mounts_file) {
+		// This might happen in a chroot/container.
+		// We can't verify, so we can't proceed.
+		return NULL;
+	}
+
+	char* line = NULL;
+	size_t len = 0;
+	char* found_options = NULL;
+	char dev[256], mnt[256], type[256], opts[4096];
+
+	while (getline(&line, &len, mounts_file) != -1) {
+		// Format: device mount_point type options dump pass
+		if (sscanf(line, "%255s %255s %255s %4095s %*d %*d", dev, mnt, type, opts) == 4) {
+			if (strcmp(mnt, mount_point) == 0) {
+				found_options = strdup(opts);
+				break;
+			}
+		}
+	}
+
+	free(line);
+	fclose(mounts_file);
+	return found_options;
+}
