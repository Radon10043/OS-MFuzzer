+	if (opts_before == NULL) {
+		// Failed to read mount state, cannot verify the MR.
+		status = -1;
+		goto cleanup;
+	}
+
+	// 4. Follow-up execution: Attempt to remount with privilege-escalating options.
+	remount_ret = mount(NULL, target_path, NULL, MS_REMOUNT, followup_options);
+	remount_errno = errno;
+
+	// 5. Get follow-up output: Read the mount options again.
+	opts_after = get_mount_options_00a81376(target_path);
+	if (opts_after == NULL) {
+		// Filesystem might have been unexpectedly unmounted. Test cannot be verified.
+		status = -1;
+		goto cleanup;
+	}
+
+	// 6. Output relation check.
+	// The remount must fail, specifically with EPERM.
+	// The mount options must remain unchanged.
+	if (remount_ret == 0 || remount_errno != EPERM || strcmp(opts_before, opts_after) != 0) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!\n");
+		status = -1;
+	}
