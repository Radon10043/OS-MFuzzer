+// Helper function to poll for a specific number of work completions
+static int poll_completions(struct ibv_cq* cq, int num_wcs)
+{
+	struct ibv_wc wc[CQ_SIZE];
+	int completions = 0;
+	struct timeval start_time, cur_time;
+	long start_ms, cur_ms;
+
+	gettimeofday(&start_time, NULL);
+	start_ms = (start_time.tv_sec * 1000) + (start_time.tv_usec / 1000);
+
+	while (completions < num_wcs) {
+		int ret = ibv_poll_cq(cq, num_wcs - completions, &wc[0]);
+		if (ret < 0) {
+			perror("[SyzMeta]: ibv_poll_cq failed");
+			return -1;
+		}
+		if (ret > 0) {
+			for (int i = 0; i < ret; ++i) {
+				if (wc[i].status != IBV_WC_SUCCESS) {
+					fprintf(stderr,
+						"[SyzMeta]: Work completion failed with status %s (opcode=%d, vendor_err=0x%x)\n",
+						ibv_wc_status_str(wc[i].status),
+						wc[i].opcode, wc[i].vendor_err);
+					return -1;
+				}
+			}
+			completions += ret;
+		}
+
+		gettimeofday(&cur_time, NULL);
+		cur_ms = (cur_time.tv_sec * 1000) + (cur_time.tv_usec / 1000);
+		if (cur_ms - start_ms > TIMEOUT_MS) {
