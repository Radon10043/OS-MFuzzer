+	if (pipe(pipefd) == -1) {
+		ret = -1;
+		goto cleanup_autofs_fd;
+	}
+
+	if (ioctl(autofs_fd, AUTOFS_IOC_SETPIPEFD_fa5a995a, pipefd[1]) == -1) {
+		ret = -1;
+		goto cleanup_pipe;
+	}
+
+	snprintf(mount_opts, sizeof(mount_opts), "fd=%d,pgrp=%d,minproto=5,maxproto=5",
+		 autofs_fd, getpgrp());
+
+	if (mount("none", mount_point, "autofs", 0, mount_opts) == -1) {
+		ret = -1;
+		goto cleanup_pipe;
+	}
+	mounted = 1;
+
+	if (ioctl(autofs_fd, AUTOFS_IOC_READY, 0) == -1) {
+		ret = -1;
+		goto cleanup_mount;
+	}
+
+	// --- 2. Source Input: Access the first missing path ---
+	pid1 = fork();
+	if (pid1 == -1) {
+		ret = -1;
+		goto cleanup_mount;
+	}
+
+	if (pid1 == 0) { // Child process 1
+		struct stat st;
+		stat(path1, &st);
+		_exit(0);
+	} else { // Parent process
+		struct autofs_v5_packet packet;
+		ssize_t n = read(pipefd[0], &packet, sizeof(packet));
+		if (n != sizeof(packet)) {
+			kill(pid1, SIGKILL);
+			waitpid(pid1, NULL, 0);
+			ret = -1;
+			goto cleanup_mount;
+		}
+		token1 = packet.wait_queue_token;
+
+		struct autofs_packet_fail_fa5a995a fail_pkt;
+		memset(&fail_pkt, 0, sizeof(fail_pkt));
+		fail_pkt.hdr.proto_version = 5;
+		fail_pkt.hdr.type = autofs_ptype_missing_indirect;
+		fail_pkt.wait_queue_token = token1;
+		ioctl(autofs_fd, AUTOFS_IOC_FAIL, &fail_pkt);
+
+		waitpid(pid1, NULL, 0);
+	}
+
+	// --- 3. Follow-up Input: Access the second missing path ---
+	pid2 = fork();
+	if (pid2 == -1) {
+		ret = -1;
+		goto cleanup_mount;
+	}
+
+	if (pid2 == 0) { // Child process 2
+		struct stat st;
+		stat(path2, &st);
+		_exit(0);
+	} else { // Parent process
+		struct autofs_v5_packet packet;
+		ssize_t n = read(pipefd[0], &packet, sizeof(packet));
+		if (n != sizeof(packet)) {
+			kill(pid2, SIGKILL);
+			waitpid(pid2, NULL, 0);
+			ret = -1;
+			goto cleanup_mount;
+		}
+		token2 = packet.wait_queue_token;
+
+		struct autofs_packet_fail_fa5a995a fail_pkt;
+		memset(&fail_pkt, 0, sizeof(fail_pkt));
+		fail_pkt.hdr.proto_version = 5;
+		fail_pkt.hdr.type = autofs_ptype_missing_indirect;
+		fail_pkt.wait_queue_token = token2;
+		ioctl(autofs_fd, AUTOFS_IOC_FAIL, &fail_pkt);
+
+		waitpid(pid2, NULL, 0);
+	}
+
+	// --- 4. Output Relation Check ---
+	if (token1 != 0 && token2 != 0 && token1 == token2) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!\n");
+	}
+
+// --- 5. Cleanup ---
+cleanup_mount:
+	if (mounted)
+		umount(mount_point);
+cleanup_pipe:
+	if (pipefd[0] != -1)
+		close(pipefd[0]);
+	if (pipefd[1] != -1)
+		close(pipefd[1]);
+cleanup_autofs_fd:
+	if (autofs_fd != -1)
+		close(autofs_fd);
+cleanup_dir:
+	rmdir(mount_point);
+
+	return ret;
+}
