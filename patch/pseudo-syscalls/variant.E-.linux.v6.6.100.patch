+static long run_one_case(uint64_t syndrome)
+{
+	int kvmfd = -1, vmfd = -1, vcpufd = -1;
+	void* mem = MAP_FAILED;
+	struct kvm_run* run = NULL;
+	long result_esr = -1;
+	int mmap_size;
+
+	kvmfd = open("/dev/kvm", O_RDWR | O_CLOEXEC);
+	if (kvmfd < 0) {
+		perror("[SyzMeta] open /dev/kvm");
+		return -1;
+	}
+
+	vmfd = ioctl(kvmfd, KVM_CREATE_VM, 0);
+	if (vmfd < 0) {
+		perror("[SyzMeta] KVM_CREATE_VM");
+		goto cleanup;
+	}
+
+	mem = mmap(NULL, GUEST_MEM_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+	if (mem == MAP_FAILED) {
+		perror("[SyzMeta] mmap guest memory");
+		goto cleanup;
+	}
+	memset(mem, 0, GUEST_MEM_SIZE);
+	memcpy((char*)mem + GUEST_CODE_START, guest_code, guest_code_len);
+
+	struct kvm_userspace_memory_region region = {
+	    .slot = 0,
+	    .guest_phys_addr = 0,
+	    .memory_size = GUEST_MEM_SIZE,
+	    .userspace_addr = (uint64_t)mem,
+	};
+	if (ioctl(vmfd, KVM_SET_USER_MEMORY_REGION, &region) < 0) {
+		perror("[SyzMeta] KVM_SET_USER_MEMORY_REGION");
+		goto cleanup;
+	}
+
+	vcpufd = ioctl(vmfd, KVM_CREATE_VCPU, 0);
+	if (vcpufd < 0) {
+		perror("[SyzMeta] KVM_CREATE_VCPU");
+		goto cleanup;
+	}
+
+	// The following block is moved to a separate scope to avoid "crosses initialization" errors with goto.
+	{
+		struct kvm_vcpu_init init;
+		if (ioctl(vcpufd, KVM_ARM_VCPU_INIT, &init) < 0) {
+			perror("[SyzMeta] KVM_ARM_VCPU_INIT");
+			goto cleanup_vcpu;
+		}
+
+		// HCR_EL2: AArch64 guest (RW=1), trap WFI (TWI=1)
+		uint64_t hcr_el2 = (1UL << 31) | (1UL << 13);
+		if (vcpu_set_reg(vcpufd, KVM_REG_ARM64_HCR_EL2, hcr_el2) < 0) {
+			perror("[SyzMeta] Set HCR_EL2");
+			goto cleanup_vcpu;
+		}
+
+		// Set PC to the start of our guest code
+		if (vcpu_set_reg(vcpufd, KVM_REG_ARM64 | KVM_REG_SIZE_U64 | KVM_REG_ARM_CORE_REG(pc), GUEST_PC_START) < 0) {
+			perror("[SyzMeta] Set PC");
+			goto cleanup_vcpu;
+		}
+		// Set PSTATE to EL1h mode (Execution state at EL1, using SP_EL1)
+		if (vcpu_set_reg(vcpufd, KVM_REG_ARM64 | KVM_REG_SIZE_U64 | KVM_REG_ARM_CORE_REG(pstate), 0x5) < 0) {
+			perror("[SyzMeta] Set PSTATE");
+			goto cleanup_vcpu;
+		}
+
+		// Inject the SError event
+		struct kvm_vcpu_events events = {0};
+		events.exception.serror_pending = 1;
+		events.exception.serror_has_esr = 1;
+		events.exception.serror_esr = syndrome;
+		if (ioctl(vcpufd, KVM_SET_VCPU_EVENTS, &events) < 0) {
+			perror("[SyzMeta] KVM_SET_VCPU_EVENTS");
+			goto cleanup_vcpu;
+		}
+	}
+
+	mmap_size = ioctl(kvmfd, KVM_GET_VCPU_MMAP_SIZE, NULL);
+	if (mmap_size < 0) {
+		perror("[SyzMeta] KVM_GET_VCPU_MMAP_SIZE");
+		goto cleanup_vcpu;
+	}
+	run = (struct kvm_run*)mmap(NULL, mmap_size, PROT_READ | PROT_WRITE, MAP_SHARED, vcpufd, 0);
+	if (run == MAP_FAILED) {
+		perror("[SyzMeta] mmap kvm_run");
+		run = NULL; // Ensure run is NULL for cleanup
+		goto cleanup_vcpu;
+	}
