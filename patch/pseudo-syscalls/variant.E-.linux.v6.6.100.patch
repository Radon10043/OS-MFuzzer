+	if (run->exit_reason == KVM_EXIT_WFI) {
+		result_esr = *(volatile uint64_t*)((char*)mem + GUEST_RESULT_ADDR);
+	} else {
+		fprintf(stderr, "[SyzMeta] Unexpected KVM exit reason: %d\n", run->exit_reason);
+		if (run->exit_reason == KVM_EXIT_FAIL_ENTRY) {
+			fprintf(stderr, "[SyzMeta] Hardware entry failure reason: 0x%llx\n", run->fail_entry.hardware_entry_failure_reason);
+		}
+		result_esr = -1;
+	}
+
+	munmap(run, mmap_size);
+cleanup_vcpu:
+	if (vcpufd >= 0)
+		close(vcpufd);
+cleanup:
+	if (mem != MAP_FAILED)
+		munmap(mem, GUEST_MEM_SIZE);
+	if (vmfd >= 0)
+		close(vmfd);
+	if (kvmfd >= 0)
+		close(kvmfd);
+	return result_esr;
