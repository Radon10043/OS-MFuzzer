+	if (ioctl(vcpu_fd, KVM_GET_REGS, &regs2) == -1) {
+		goto cleanup;
+	}
+	RAX2 = regs2.rax;
+
+	// 4. Check the output relation
+	if (RAX1 != (unsigned long long)V_orig || RAX2 != (unsigned long long)V_new) {
+		fprintf(stderr, "[SyzMeta]: MR is violated!");
+	}
+
+cleanup:
+	// 5. Cleanup resources
+	if (kvm_run_ptr)
+		munmap(kvm_run_ptr, mmap_size);
+	if (guest_mem)
+		munmap(guest_mem, GUEST_MEM_SIZE_fe9b4328);
+	if (vcpu_fd != -1)
+		close(vcpu_fd);
+	if (vm_fd != -1)
+		close(vm_fd);
+	if (kvm_fd != -1)
+		close(kvm_fd);
+
+	return ret;
+}
