+// Establish QP connection
+static int connect_qp(struct resources* res, int ib_port, int gid_idx)
+{
+	struct conn_data local_conn, remote_conn;
+	struct ibv_port_attr port_attr;
+
+	if (ibv_query_port(res->context, ib_port, &port_attr)) {
+		fprintf(stderr, "ibv_query_port failed\n");
+		return -1;
+	}
+	if (ibv_query_gid(res->context, ib_port, gid_idx, &local_conn.gid)) {
+		fprintf(stderr, "ibv_query_gid failed\n");
+		return -1;
+	}
+
+	local_conn.qp_num = res->qp->qp_num;
+	local_conn.lid = port_attr.lid;
+
+	if (sock_sync_data(res->sock, sizeof(struct conn_data), (char*)&local_conn, (char*)&remote_conn)) {
+		fprintf(stderr, "Failed to exchange connection data\n");
+		return -1;
+	}
+
+	if (modify_qp_to_init(res->qp, ib_port))
+		return -1;
+	if (modify_qp_to_rtr(res->qp, remote_conn.qp_num, remote_conn.lid, &remote_conn.gid, ib_port, gid_idx))
+		return -1;
+	if (modify_qp_to_rts(res->qp))
+		return -1;
+	return 0;
+}
