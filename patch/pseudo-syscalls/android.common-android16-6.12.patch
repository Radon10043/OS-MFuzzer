+// Set up all necessary RDMA resources
+static struct resources* setup_rdma_resources(int sock)
+{
+	struct resources* res = (struct resources*)calloc(1, sizeof(struct resources));
+	if (!res) {
+		fprintf(stderr, "Failed to allocate memory for resources\n");
+		return NULL;
