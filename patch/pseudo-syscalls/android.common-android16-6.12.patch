+			return -1;
+		}
+		// Wait for B's send signal
+		if (read(sock, &temp_char, 1) != 1) {
+			fprintf(stderr, "Client A failed to read sync char from B\n");
+			resources_destroy(res);
+			return -1;
+		}
+	} else {
+		// Follow-up case: Send is posted before Recv
+		// Signal B to send
+		if (write(sock, "A", 1) != 1) {
+			fprintf(stderr, "Client A failed to write sync char\n");
+			resources_destroy(res);
+			return -1;
+		}
