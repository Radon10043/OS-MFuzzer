+// Poll the completion queue for a work completion
+static int poll_completion(struct resources* res)
+{
+	struct ibv_wc wc;
+	int num_comp;
+	int retries = 1000; // Timeout to prevent hangs
+	do {
+		num_comp = ibv_poll_cq(res->cq, 1, &wc);
+		if (num_comp == 0) {
+			usleep(1000); // 1ms
+			retries--;
+		}
+	} while (num_comp == 0 && retries > 0);
+
+	if (num_comp < 0) {
+		fprintf(stderr, "Poll CQ failed\n");
+		return -1;
+	}
+	if (retries == 0) {
+		fprintf(stderr, "Poll CQ timed out\n");
+		return -1;
+	}
+	if (wc.status != IBV_WC_SUCCESS) {
+		fprintf(stderr, "Work completion failed with status %s (%d)\n", ibv_wc_status_str(wc.status), wc.status);
+		return -1;
+	}
+	return 0;
+}
