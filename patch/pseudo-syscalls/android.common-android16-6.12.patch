+	res->sock = sock;
+
+	struct ibv_device** dev_list = NULL;
+	struct ibv_device* ib_dev = NULL;
+	int num_devices;
+
+	dev_list = ibv_get_device_list(&num_devices);
+	if (!dev_list) {
+		fprintf(stderr, "Failed to get RDMA devices list\n");
+		goto error_out;
+	}
+	if (num_devices == 0) {
+		fprintf(stderr, "No RDMA devices found\n");
+		goto error_out;
+	}
+	ib_dev = dev_list[0]; // Pick the first device
+
+	res->context = ibv_open_device(ib_dev);
+	if (!res->context) {
+		fprintf(stderr, "Failed to open device %s\n", ibv_get_device_name(ib_dev));
+		goto error_out;
+	}
+	ibv_free_device_list(dev_list);
+	dev_list = NULL;
+
+	res->pd = ibv_alloc_pd(res->context);
+	if (!res->pd) {
+		fprintf(stderr, "Failed to allocate PD\n");
+		goto error_out;
+	}
+
+	res->cq = ibv_create_cq(res->context, 10, NULL, NULL, 0);
+	if (!res->cq) {
+		fprintf(stderr, "Failed to create CQ\n");
+		goto error_out;
+	}
+
+	res->buf = (char*)malloc(BUF_SIZE);
+	if (!res->buf) {
+		fprintf(stderr, "Failed to allocate memory for buffer\n");
+		goto error_out;
+	}
+
+	res->mr = ibv_reg_mr(res->pd, res->buf, BUF_SIZE, IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE);
+	if (!res->mr) {
+		fprintf(stderr, "Failed to register MR\n");
+		goto error_out;
+	}
+
+	struct ibv_qp_init_attr qp_init_attr;
+	memset(&qp_init_attr, 0, sizeof(qp_init_attr));
+	qp_init_attr.send_cq = res->cq;
+	qp_init_attr.recv_cq = res->cq;
+	qp_init_attr.qp_type = IBV_QPT_RC;
+	qp_init_attr.cap.max_send_wr = 10;
+	qp_init_attr.cap.max_recv_wr = 10;
+	qp_init_attr.cap.max_send_sge = 1;
+	qp_init_attr.cap.max_recv_sge = 1;
