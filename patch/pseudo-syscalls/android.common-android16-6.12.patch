+// Main logic for Client B (Sender process)
+static int client_b_main(int sock)
+{
+	struct resources* res = setup_rdma_resources(sock);
+	if (!res)
+		return -1;
+
+	strcpy(res->buf, MSG_CONTENT);
+	if (connect_qp(res, IB_PORT, GID_IDX) != 0) {
+		resources_destroy(res);
+		return -1;
+	}
+
+	char temp_char;
+	// Wait for signal from A to start its operation
+	if (read(sock, &temp_char, 1) != 1) {
+		fprintf(stderr, "Client B failed to read sync char\n");
+		resources_destroy(res);
+		return -1;
+	}
+
+	if (post_send(res) != 0) {
+		resources_destroy(res);
+		return -1;
+	}
+
+	// Signal A that send is posted
+	if (write(sock, "B", 1) != 1) {
+		fprintf(stderr, "Client B failed to write sync char\n");
+		resources_destroy(res);
+		return -1;
+	}
+
